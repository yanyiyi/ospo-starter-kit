#: oss-policy-templates/introduction.md:10
#, no-wrap, ignore-same
msgid ""
"```text\n"
"oss-policy-templates/\n"
"├── introduction.md          # This file (Usage and Article List)\n"
"└── articles/                # Individual Article Files\n"
"    ├── 00_preamble.md\n"
"    ├── 01_purpose.md\n"
"    ├── 02_definitions.md\n"
"    ├── 03_scope.md\n"
"    ├── 04_ospo.md\n"
"    ├── 05_oss_usage.md\n"
"    ├── 06_contribution.md\n"
"    ├── 07_oss_release.md\n"
"    ├── 08_personal_oss_activity.md\n"
"    ├── 09_trademark_and_brand.md\n"
"    ├── 10_license_violation_incident.md\n"
"    ├── 11_security_and_vulnerability.md\n"
"    ├── 12_records_and_reporting.md\n"
"    ├── 13_education_and_awareness.md\n"
"    ├── 14_employment_rules_relation.md\n"
"    └── 15_revision_and_enforcement.md\n"
"```"
msgstr ""

#. type: 段落
#: oss-policy-templates/introduction.md:11
msgid "The leading two-digit number in file names under `articles/` corresponds to the article number (Article 0 to Article 15)."
msgstr ""

