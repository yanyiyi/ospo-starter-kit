#. type: 標題
#: operation-templates/compliance/license-types.md:1
msgid "# Types of Licenses"
msgstr ""

#. type: 註解
#: operation-templates/compliance/license-types.md:2
msgid ""
"<!--\n"
"########################################################################################\n"
"For OSPO Staff: How to Use This Template\n"
"\n"
"1. Add marks or notes to licenses frequently used in your company.\n"
"2. Verify completeness using the customization checklist.\n"
"3. Refer to the customization guide at the end to expand content based on your company's context.\n"
"\n"
